---
import Header from "../components/ui/Header.astro";
import Layout from "../layouts/Layout.astro";
import {
	FaAngleLeft,
	FaAngleRight,
	FaGithub,
	FaLinkedin,
	FaRegEnvelope,
} from "react-icons/fa";

import { stack } from "../data/stack";

import ProjectCard from "../components/project/ProjectCard.astro";
import { projects } from "../data/projects";
import Bento from "../components/about/Bento.astro";
import ContactSection from "../components/contact/Contact.astro";

const links = [
	{ name: "Inicio", href: "#main" },
	{ name: "Proyectos", href: "#projects" },
	{ name: "Conocimientos", href: "#knowledge" },
	{ name: "Sobre mí", href: "#about" },
	{ name: "Contacto", href: "#contact" },
];
---

<Layout>
	<main
		class="flex flex-col min-h-[100dvh] bg-gradient-to-br from-[#b9ceff] to-gray-100"
	>
		<Header />
		<section class="flex-grow w-full relative flex" id="main">
			<div
				class="flex justify-evenly items-center md:flex-row flex-col min-h-[500px] my-auto w-full"
			>
				<div class="h-fit w-fit ">
					<img
						alt="Lautaro Ezequiel photo"
						src="/assets/LautaroEzequiel.jpg"
						class="object-cover w-52 h-52 rounded-full border shadow-2xl shadow-blue-900 hover:-rotate-y-[20deg] transition-transform duration-200"
					/>
				</div>
				<div class="">
					<h1 class="text-4xl font-bold">
						Hola!<br /> Soy <span class="text-[#6b97ff]"
							>Lautaro Ezequiel</span
						>
					</h1>
					<h2 class="text-2xl">
						Desarrollador <b class="text-gray-700/80">Full Stack</b>
					</h2>

					<nav class="mt-6 flex gap-2 align-middle h-fit">
						<FaAngleLeft className="my-auto" />
						<ul class="flex gap-4">
							<li>
								<a
									href="https://github.com/lautarourquiza"
									target="_blank"
									><FaGithub
										className="text-3xl hover:scale-105 transition-transform duration-100"
									/></a
								>
							</li>
							<li>
								<a
									href="https://www.linkedin.com/in/lautaro-ezequiel-urquiza/"
									target="_blank"
									><FaLinkedin
										className="text-3xl hover:scale-105 transition-transform duration-100"
									/></a
								>
							</li>
							<li class="relative group ">
								<button
									id="copy-email"
									type="button"
									class="relative"
									aria-label="Copiar mail"
								>
									<FaRegEnvelope
										className="text-3xl hover:scale-105 transition-transform duration-150 cursor-pointer"
									/>
								</button>

								<span
									id="tooltip"
									class="absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs rounded-md px-2 py-1 opacity-0 scale-95 group-hover:opacity-100 group-hover:scale-100 transition-all duration-150 pointer-events-none"
								>
									Copiar mail
								</span>
							</li>
						</ul>
						<FaAngleRight className="my-auto" />
					</nav>
				</div>
			</div>
		</section>
	</main>
	<section
		id="projects"
		class="min-h-screen bg-gradient-to-bl to-[#b9ceff] from-gray-100 p-10 flex flex-col items-center justify-center overflow-hidden"
	>
		<h2 class="text-xl md:text-3xl font-bold text-gray-800 mb-6">
			Proyectos en los que trabajé
		</h2>

		<div
			class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 max-w-7xl w-11/12 mx-auto"
		>
			{projects.map((p) => <ProjectCard {...p} />)}
		</div>
	</section>
	<section
		id="knowledge"
		class="min-h-screen bg-gradient-to-tl to-[#b9ceff] from-gray-100 p-10 flex flex-col items-center justify-center"
	>
		<h2 class="text-xl md:text-3xl font-bold text-black mb-6">
			Tech Stack & Herramientas
		</h2>

		<div
			class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 max-w-7xl w-9/12 mx-auto"
		>
			{
				stack.map((i) => (
					<div class="relative group flex flex-col items-center">
						<div class="p-4 rounded-full bg-white/60 backdrop-blur-sm shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
							<img
								class="size-10 md:size-12"
								src={`https://cdn.simpleicons.org/${i.name}/${i.color}`}
								alt={i.title}
							/>
						</div>
						<span class="absolute -bottom-4 opacity-0 group-hover:opacity-100 text-xs font-medium text-gray-700 transition-opacity duration-300">
							{i.title}
						</span>
					</div>
				))
			}
		</div>
	</section>
</Layout>

<section
	id="about"
	class="min-h-screen bg-gradient-to-bl from-gray-100 to-[#b9ceff] p-10 flex flex-col items-center justify-center text-center"
>
	<Bento />
</section>
<section
	id="contact"
	class="min-h-screen bg-gradient-to-tl to-[#b9ceff] from-gray-100 p-10 flex flex-col items-center justify-center"
>
	<ContactSection />
</section>
<footer
	class="relative w-full bg-gradient-to-b from-[#b9ceff] via-[#c8d7ff] to-[#e6ecff] text-gray-800 py-10 mt-auto border-t border-white/40 backdrop-blur-sm"
>
	<div
		class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-6 items-center"
	>
		<div class="flex justify-center md:justify-start items-center">
			<p
				class="font-bold text-2xl tracking-tight flex items-center gap-1"
			>
				<span class="text-[#3e78ff]">{"{"}</span>
				Lautaro Ezequiel
				<span class="text-[#6b97ff]">{"/}"}</span>
			</p>
		</div>

		<div
			class="flex flex-wrap justify-center md:justify-end gap-6 text-base font-medium"
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						class="relative group text-gray-700 hover:text-[#3e78ff] transition-all duration-300"
					>
						{link.name}
						<span class="absolute left-0 -bottom-1 w-0 h-0.5 bg-[#3e78ff] rounded-full transition-all duration-300 group-hover:w-full" />
					</a>
				))
			}
		</div>
	</div>

	<div class="w-11/12 mx-auto my-6 h-px bg-white/40"></div>

	<div
		class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-600"
	>
		<p>
			© 2025 <span class="font-semibold text-gray-800"
				>Lautaro Urquiza</span>
		</p>

		<ul class="flex gap-4">
			<li>
				<a
					href="mailto:lautaroezequielurquiza@gmail.com"
					aria-label="Email"
					class="hover:text-[#3e78ff] transition-colors"
				>
					<FaRegEnvelope className="text-xl" />
				</a>
			</li>
			<li>
				<a
					href="https://github.com/lautarourquiza"
					aria-label="GitHub"
					target="_blank"
					rel="noreferrer"
					class="hover:text-[#3e78ff] transition-colors"
				>
					<FaGithub className="text-xl" />
				</a>
			</li>
			<li>
				<a
					href="https://linkedin.com/in/lautarourquiza"
					aria-label="LinkedIn"
					target="_blank"
					rel="noreferrer"
					class="hover:text-[#3e78ff] transition-colors"
				>
					<FaLinkedin className="text-xl" />
				</a>
			</li>
		</ul>
	</div>
</footer>

<script>
  const btn = document.getElementById('copy-email');
  const tooltip = document.getElementById('tooltip');
  const email = 'lautaroezequielurquiza@gmail.com';

  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      tooltip.textContent = '¡Copiado!';
      tooltip.classList.add('bg-green-600');
      setTimeout(() => {
        tooltip.textContent = 'Copiar mail';
        tooltip.classList.remove('bg-green-600');
      }, 2000);
    } catch (e) {
      tooltip.textContent = 'Error 😢';
    }
  });
</script>